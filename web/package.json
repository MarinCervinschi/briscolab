{
	"name": "briscolab-web",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"license": "MIT",
	"packageManager": "pnpm@10.30.1",
	"scripts": {
		"dev": "pnpm i18n && pnpm wasm && vite dev --port 3000",
		"build": "pnpm wasm && vite build && node scripts/sw.mjs",
		"preview": "python3 -m http.server 4173 --directory dist/client",
		"typecheck": "pnpm i18n && pnpm wasm && tsc --noEmit",
		"test": "pnpm i18n && pnpm wasm && vitest run",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"icons": "node scripts/make-icons.mjs",
		"i18n": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide",
		"wasm": "cargo build --manifest-path ../engine/Cargo.toml -p briscolab-wasm --release --target wasm32-unknown-unknown && wasm-bindgen --target web --out-dir src/engine/pkg ../engine/target/wasm32-unknown-unknown/release/briscolab_wasm.wasm"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild",
			"lightningcss"
		]
	},
	"dependencies": {
		"@fontsource/jetbrains-mono": "5.3.0",
		"@fontsource/space-grotesk": "5.3.0",
		"@tailwindcss/vite": "^4.3.3",
		"@tanstack/react-router": "^1.170.46",
		"@tanstack/react-start": "^1.169.4",
		"motion": "^14.7.1",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"tailwindcss": "^4.3.3"
	},
	"devDependencies": {
		"@inlang/paraglide-js": "2.29.0",
		"@resvg/resvg-js": "2.6.2",
		"@trivago/prettier-plugin-sort-imports": "^6.0.2",
		"@types/node": "^26.6.5",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.1.2",
		"prettier": "^3.9.10",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"typescript": "^7.0.2",
		"vite": "^8.3.5",
		"vite-plugin-pwa": "2.0.0",
		"vitest": "^5.0.5",
		"workbox-build": "7.4.1"
	}
}
